# GitHub: token personal de solo lectura. Los repositorios se descubren desde GitHub
# y se seleccionan después desde la interfaz web.
GITHUB_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Acceso a la interfaz. Para publicar en Internet, usa HTTPS y activa la cookie Secure.
AUTH_USERNAME=admin
AUTH_PASSWORD=cambia-esta-contrasena-por-una-larga-y-unica
AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=12
# Opcional: ruta absoluta a una CA en PEM si la red inspecciona HTTPS.
# GITHUB_CA_CERT_FILE=C:/ruta/a/ca-corporativa.pem

# LM Studio (API compatible con OpenAI).
# Dejar LMSTUDIO_MODEL vacío permite elegirlo desde la interfaz tras consultar /v1/models.
LMSTUDIO_BASE_URL=http://192.168.10.206:1234/v1
LMSTUDIO_MODEL=

# Valores iniciales de la aplicación. Después podrán modificarse desde la interfaz.
DATA_DIRECTORY=./data
SYNC_INTERVAL_MINUTES=5
APP_PORT=3000
DEFAULT_LANGUAGE=es

# Asana (opcional). El token nunca se expone al navegador.
# Se requieren permisos de lectura para tareas, proyectos, stories y adjuntos.
ASANA_TOKEN=
ASANA_WORKSPACE_ID=
# Opcional. Ruta a la CA PEM para redes que inspeccionan HTTPS. Si se omite,
# se reutiliza GITHUB_CA_CERT_FILE cuando exista.
ASANA_CA_CERT_FILE=
ASANA_TIMEOUT_MS=30000
ASANA_MAX_RETRIES=3
# Límite por adjunto descargado y preservado localmente.
ASANA_MAX_ATTACHMENT_BYTES=26214400
